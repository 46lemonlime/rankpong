# ==========================================
# RankPong Environment Variables Example
# ==========================================
# Copy this file to .env.local for local development.
# DO NOT commit real secrets or production keys to version control.

# ------------------------------------------
# Public Application Configuration
# ------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
# Public Supabase URL for client and server queries
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase Anon (publishable) Key for browser/client-side access
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Service Role Key for elevated backend tasks
# WARNING: NEVER expose this key to client-side code or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------
# Resend Email Service Configuration
# ------------------------------------------
# Server-only API key for sending transactional emails
RESEND_API_KEY=re_your_resend_api_key
